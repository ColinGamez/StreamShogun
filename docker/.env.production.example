# ── Database ───────────────────────────────────────────
POSTGRES_PASSWORD="<generate-a-random-database-password>"

# ── JWT ────────────────────────────────────────────────
JWT_SECRET="<generate-a-random-64-character-value>"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── Web / App URLs ─────────────────────────────────────
CORS_ORIGIN="https://streamshogun.com"
APP_PUBLIC_URL="https://streamshogun.com"
COOKIE_DOMAIN=".streamshogun.com"
GOOGLE_CLIENT_ID="<google-client-id>.apps.googleusercontent.com"

# ── Email ──────────────────────────────────────────────
SUPPORT_EMAIL="colin.kenny777@gmail.com"
RESEND_API_KEY="<resend-api-key>"
EMAIL_FROM="StreamShogun <no-reply@streamshogun.com>"
# Or use SMTP instead of Resend:
# SMTP_URL="smtps://username:<smtp-password>@smtp.example.com:465"

# ── Observability / Admin ──────────────────────────────
LOG_LEVEL="info"
# ADMIN_KEY="<generate-a-random-admin-key>"
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# ── Stripe (optional — enables /v1/billing) ───────────
# STRIPE_SECRET_KEY="<live Stripe secret key>"
# STRIPE_WEBHOOK_SECRET="<Stripe webhook secret>"
# STRIPE_PRICE_ID_PRO_MONTHLY="price_..."
# STRIPE_PRICE_ID_PRO_YEARLY="price_..."
# STRIPE_PORTAL_RETURN_URL="https://streamshogun.com/account"
# BILLING_DISABLED="true"

# ── Optional app flags ─────────────────────────────────
# FOUNDING_MEMBER_CUTOFF="2026-06-01T00:00:00.000Z"
