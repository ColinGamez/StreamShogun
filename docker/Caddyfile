# Shared site routing for both the local preview and production blocks.
# Keep these clean-URL rewrites in sync with vercel.json, site/vercel.json
# and site/_redirects — all four serve the same static site.
(site-routes) {
	@login path /login
	rewrite @login /login.html

	@register path /register
	rewrite @register /register.html

	@account path /account
	rewrite @account /account.html

	@terms path /terms
	rewrite @terms /terms.html

	@privacy path /privacy
	rewrite @privacy /privacy.html

	@changelog path /changelog
	rewrite @changelog /changelog.html

	@forgot path /forgot-password
	rewrite @forgot /forgot-password.html

	@reset path /reset-password
	rewrite @reset /reset-password.html

	@billing-success path /billing/success
	rewrite @billing-success /billing/success.html

	@billing-cancel path /billing/cancel
	rewrite @billing-cancel /billing/cancel.html

	@community path /community
	rewrite @community /community.html

	@blog-legal path /blog/the-legal-guide-to-free-iptv
	rewrite @blog-legal /blog/the-legal-guide-to-free-iptv.html

	@profile path_regexp profile ^/u(?:/.*)?$
	rewrite @profile /profile.html

	header /robots.txt Cache-Control "public, max-age=86400"
	header /sitemap.xml Cache-Control "public, max-age=86400"
	header /feed.xml Cache-Control "public, max-age=3600"
	header /feed.xml Content-Type "application/atom+xml; charset=utf-8"

	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

http://localhost:5173, http://127.0.0.1:5173 {
	root * /srv/site
	encode zstd gzip

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8787
	}

	import site-routes

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		X-DNS-Prefetch-Control "on"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://accounts.google.com; frame-src 'self' https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}

www.streamshogun.com {
	redir https://streamshogun.com{uri} permanent
}

streamshogun.com {
	root * /srv/site
	encode zstd gzip

	import site-routes

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		X-DNS-Prefetch-Control "on"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.streamshogun.com https://accounts.google.com; frame-src 'self' https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.streamshogun.com"
	}
}

api.streamshogun.com {
	encode zstd gzip
	reverse_proxy api:8787
}
