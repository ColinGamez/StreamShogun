# ── Server ─────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# ── Database ───────────────────────────────────────────
# Local PG: postgresql://postgres:<password>@localhost:5433/streamshogun?schema=public
# Docker:   postgresql://shogun:shogun@localhost:5432/streamshogun?schema=public
DATABASE_URL="postgresql://postgres:changeme@localhost:5433/streamshogun?schema=public"

# ── JWT ────────────────────────────────────────────────
JWT_SECRET="<generate-a-random-64-character-value>"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── Web / App URLs ─────────────────────────────────────
# Local site origin for browser requests
CORS_ORIGIN="http://localhost:5173"
# Public marketing/app URL used in password reset links and billing returns
APP_PUBLIC_URL="http://localhost:5173"
# Google Sign-In web client ID from Google Cloud Console
# GOOGLE_CLIENT_ID="1234567890-abc123.apps.googleusercontent.com"
# In production set this to .streamshogun.com so auth cookies work across subdomains
# COOKIE_DOMAIN=".streamshogun.com"

# ── Email (password resets / transactional) ────────────
SUPPORT_EMAIL="support@streamshogun.com"
# Recommended free path: Resend
# Easiest setup: paste your Resend API key and the app will call Resend directly.
# RESEND_API_KEY="<resend-api-key>"
# Or use a raw SMTP connection string if you prefer another provider:
# SMTP_URL="smtps://resend:<resend-api-key>@smtp.resend.com:465"
# Use a verified sender on your Resend domain, even if support replies go somewhere else.
# EMAIL_FROM="StreamShogun <no-reply@streamshogun.com>"
# SUPPORT_EMAIL="your-real-inbox@gmail.com"

# ── Observability (optional) ───────────────────────────
LOG_LEVEL=debug
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# ── Admin (optional — enables /v1/admin endpoints) ────
# ADMIN_KEY="<generate-a-random-admin-key>"

# ── Stripe (optional — enables /v1/billing) ───────────
# STRIPE_SECRET_KEY="<test Stripe secret key>"
# STRIPE_WEBHOOK_SECRET="<Stripe webhook secret>"
# STRIPE_PRICE_ID_PRO_MONTHLY="price_..."
# STRIPE_PRICE_ID_PRO_YEARLY="price_..."
# STRIPE_PORTAL_RETURN_URL="https://streamshogun.com/account"
# BILLING_DISABLED="true"

# ── Optional app flags ─────────────────────────────────
# FOUNDING_MEMBER_CUTOFF="2026-06-01T00:00:00.000Z"
