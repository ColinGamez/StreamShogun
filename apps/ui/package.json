{
  "name": "@stream-shogun/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/vite/bin/vite.js",
    "dev:electron": "concurrently -k -n UI,ELECTRON \"node ../../node_modules/vite/bin/vite.js\" \"pnpm --filter @stream-shogun/desktop dev\"",
    "build": "tsc -b && node ../../node_modules/vite/bin/vite.js build",
    "test": "vitest run",
    "preview": "node ../../node_modules/vite/bin/vite.js preview",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@stream-shogun/core": "workspace:*",
    "@stream-shogun/shared": "workspace:*",
    "hls.js": "^1.6.16",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.4",
    "typescript": "^5.4.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
